# Copie para .env (ja ignorado pelo git) e preencha.
# NUNCA commite estes valores nem cole em chat.

# Cliente OAuth do Fortnite usado para autenticar.
EPIC_OAUTH_CLIENT_ID=
EPIC_OAUTH_CLIENT_SECRET=

# Device auth de uma conta Epic SECUNDARIA (nunca a principal do estudio).
# Gere com: python -m tools.bootstrap_device_auth <authorizationCode>
EPIC_DEVICE_AUTH_ACCOUNT_ID=
EPIC_DEVICE_AUTH_DEVICE_ID=
EPIC_DEVICE_AUTH_SECRET=
