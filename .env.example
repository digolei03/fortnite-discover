# Copie para .env (ja ignorado pelo git) e preencha.
# NUNCA use a service role key aqui: ela ignora o RLS de todas as tabelas do
# projeto Supabase, e o projeto uefntoolkit e de terceiro.

UEFN_DATA_API_URL=https://<project-ref>.supabase.co
UEFN_SUPABASE_ANON_KEY=<chave anon do projeto (publica por design)>
UEFN_REFRESH_TOKEN=<refresh token de um usuario com papel editor>

# Alternativa so para rodar a mao (expira em ~1h):
# UEFN_DATA_API_TOKEN=<access token valido>
